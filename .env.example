# ═══════════════════════════════════════════════════
# Engineering AI Assistant — Environment Configuration
# ═══════════════════════════════════════════════════
# Copy this to .env and fill in your values.
# At least ONE LLM provider API key is required.

# ─── LLM Providers ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=your-gemini-key-here

# Primary provider (anthropic | openai | gemini)
LLM_PROVIDER=anthropic

# ─── External Tool Integrations (Optional) ─────────
# Leave blank to use mock data for demos

GITHUB_TOKEN=ghp_your-github-token
GITHUB_ORG=your-github-org

SLACK_BOT_TOKEN=xoxb-your-slack-token

# ─── Database (Optional) ───────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/engineering_ai

# ─── Vector Database ───────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma

# ─── Security ──────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:5173

# ─── Observability ─────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console   # console | json

# ─── Code Analysis Sandbox ─────────────────────────
CODE_ROOT=./sample_data
